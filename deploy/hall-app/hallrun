#!/usr/bin/env bash
# Launch the HalLMediaPipe interactive app on the Jetson's local display.
#
# The app opens a GUI window (camera feed + skeleton overlay + pinch-driven
# UI) and reads the Logitech C920 on /dev/video0, so a monitor AND the camera
# must be attached to the Jetson. This is a foreground interactive app, not a
# service: press 'q' in the window to quit.
#
#   hallrun                 # from a terminal on the Jetson desktop
#   DISPLAY=:0 hallrun      # over SSH, draw on the attached monitor
#
# For the browser-rendered UI instead of the cv2 window, use `hallkiosk`
# (wraps this script with HALL_OUTPUT=web and opens Chromium fullscreen), or
# run `HALL_OUTPUT=web hallrun` and open http://<jetson>:8092/ yourself.
#
# Note: the camera-stream service and this app both want the C920 — only one
# can hold it at a time. Run `camctl off` before launching if the stream is on.
set -euo pipefail

APP_DIR="${HALL_APP_DIR:-$HOME/HalLMediaPipe}"
export DISPLAY="${DISPLAY:-:0}"

# Default the HAND inference backend to the GPU (onnxruntime CUDA EP) on the
# Jetson. Measured on this board: ~2x faster hand tracking than the CPU
# MediaPipe path (13 -> 27 fps) and it offloads the work to the Tegra GPU,
# dropping the app from ~318% to ~214% CPU. Override with
# HALL_INFERENCE=mediapipe to A/B against the all-CPU path.
export HALL_INFERENCE="${HALL_INFERENCE:-gpu}"

# Default the BODY-POSE backend to the GPU too (onnxruntime BlazePose person-det
# + pose-landmark on the same TensorRT/CUDA chain as the hands). The CPU
# MediaPipe pose ran ~13 fps one inference behind and was the body's stutter/lag
# source while the GPU hands felt snappy; running pose on the GPU lifts its rate
# and frees the ~1.5 CPU cores it ate. Pose is only built when a feature needs it
# (the Vtuber rig, or HALL_POSE=1), so this costs nothing until then. First launch
# on a fresh .trt_cache builds two more FP16 engines (~1-2 min each, then cached).
# Override with HALL_POSE_INFERENCE=mediapipe to A/B against the CPU pose path.
export HALL_POSE_INFERENCE="${HALL_POSE_INFERENCE:-gpu}"

# Hand ONNX nets run on TensorRT (FP16) first — measured ~2.9x faster than the
# plain CUDA EP on this Orin, and it leaves the GPU mostly idle (headroom for the
# black-hole shader). The compiled engine is cached (TRT_ENGINE_CACHE in
# config.py) and survives deploys, so only the FIRST launch on a fresh cache pays
# the ~2 min build; every launch after reuses it. CUDA then CPU stay as
# fallbacks. Override the whole chain with HALL_ONNX_PROVIDERS.
export HALL_ONNX_PROVIDERS="${HALL_ONNX_PROVIDERS:-TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider}"

# Cap each TRT engine's build workspace to 512 MiB. The Orin Nano's 8 GB is
# SHARED CPU+GPU and with the Vtuber active four engines build/run (palm +
# handpose + pose-detector + pose-landmark) beside the kiosk browser + the
# black-hole shader — a default (unbounded) workspace can OOM the board during a
# rebuild. 512 MiB was measured sufficient to build all four (pose engines ~2 min
# each). Only affects BUILDS; cached engines are reused regardless, so this is a
# no-op once .trt_cache is warm — it just makes a cold rebuild safe. Override/lift
# with HALL_TRT_MAX_WORKSPACE (blank = TensorRT's own default).
export HALL_TRT_MAX_WORKSPACE="${HALL_TRT_MAX_WORKSPACE:-512}"

# When started over SSH there is no X cookie in the environment; reuse the
# local graphical session's so the window lands on the attached monitor.
if [ -z "${XAUTHORITY:-}" ]; then
  for xa in "$HOME/.Xauthority" "/run/user/$(id -u)/gdm/Xauthority"; do
    if [ -r "$xa" ]; then export XAUTHORITY="$xa"; break; fi
  done
fi

# Run from the repo root so the relative model paths in config.py resolve, and
# let python put src/ on sys.path[0] (matches `python src/main.py` locally).
# Tee output to a log so a crash/traceback is captured on the device even when
# launched over SSH (-u keeps it unbuffered so the log stays current).
cd "$APP_DIR"
python3 -u src/main.py "$@" 2>&1 | tee -a /tmp/hall-app.log
