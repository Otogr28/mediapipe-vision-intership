#!/usr/bin/env bash
# hallpush — despliega HalLMediaPipe al Jetson: add + commit + push + synca.
#
# El kiosko del Jetson se auto-actualiza desde origin/main (hall-update.timer
# hace pull cada ~60 s y reinicia el kiosko), así que "desplegar" ES pushear a
# main. Este comando empaqueta el flujo completo desde la laptop:
#
#   1. git add -A + commit        (mensaje = tus argumentos, o uno automático
#                                  "hallpush: fecha (host)" al estilo synca)
#   2. git pull --rebase + push   -> el exhibit se actualiza solo en ~1 min
#   3. synca                      -> el vault padre registra el puntero nuevo
#                                    del submodule y se respalda todo lo demás
#
# Uso:
#   hallpush                        commit automático + push + synca
#   hallpush arreglo del gato       ídem, con ese mensaje de commit
#   hallpush -w mensaje...          además ESPERA a que el Jetson tenga el
#                                   commit (ssh por Tailscale) y palpa /healthz
#   hallpush -n mensaje...          sin synca (solo este repo)
#   hallpush --dry-run              muestra qué haría; no toca nada
#
# Igual que synca: NUNCA --force. Si el pull --rebase entra en conflicto,
# aborta el rebase (deja el repo limpio) y te lo dice; lo resuelves tú.
#
# Instalar tras un clone fresco (igual que tools/synca/install.sh):
#   ln -sfn <repo>/deploy/hall-app/hallpush ~/.local/bin/hallpush
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SELF")/../.." && pwd)"
JETSON="${HALLPUSH_JETSON:-jetson@100.91.206.114}"
HEALTH="${HALLPUSH_HEALTH:-http://100.91.206.114:8092/healthz}"

if [ -t 1 ]; then
  C_RST=$'\e[0m'; C_B=$'\e[1m'; C_GRN=$'\e[32m'; C_YEL=$'\e[33m'; C_RED=$'\e[31m'
else
  C_RST=; C_B=; C_GRN=; C_YEL=; C_RED=
fi
say()  { printf '%s\n' "$*"; }
die()  { say "${C_RED}✗ $*${C_RST}"; exit 1; }
g()    { git -C "$REPO" "$@"; }

WAIT=0; SYNC=1; DRY=0; MSG_WORDS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -w|--wait)    WAIT=1 ;;
    -n|--no-sync) SYNC=0 ;;
    --dry-run)    DRY=1 ;;
    -h|--help)    sed -n '2,27p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)            MSG_WORDS+=("$1") ;;
  esac
  shift
done

BRANCH="$(g symbolic-ref --short HEAD 2>/dev/null)" \
  || die "HEAD suelto en $REPO — párate en main primero"
[ "$BRANCH" = "main" ] \
  || die "estás en '$BRANCH', y el Jetson solo despliega main. Cambia de rama o mergea."

MSG="${MSG_WORDS[*]:-}"
[ -n "$MSG" ] || MSG="hallpush: $(date '+%Y-%m-%d %H:%M') ($(hostname -s))"

if [ "$DRY" = 1 ]; then
  say "${C_B}hallpush --dry-run${C_RST}  (repo: $REPO)"
  say "  commit que haría: \"$MSG\""
  say "  cambios sin commitear:"
  g status --short | sed 's/^/    /'
  [ -n "$(g status --porcelain)" ] || say "    (ninguno)"
  AHEAD="$(g rev-list --count origin/main..main 2>/dev/null || echo '?')"
  say "  commits locales sin pushear: $AHEAD"
  say "  luego: git pull --rebase && git push origin main"
  [ "$SYNC" = 1 ] && say "  luego: synca (vault + puntero del submodule)"
  [ "$WAIT" = 1 ] && say "  luego: esperar el commit en $JETSON"
  exit 0
fi

# 1. add + commit -------------------------------------------------------------
g add -A
if g diff --cached --quiet; then
  say "· nada nuevo que commitear"
else
  g commit -m "$MSG" --quiet || die "commit falló"
  say "${C_GRN}✓ commit${C_RST} \"$MSG\""
fi

# 2. pull --rebase + push -----------------------------------------------------
if ! g pull --rebase --quiet origin main; then
  g rebase --abort 2>/dev/null
  die "pull --rebase entró en conflicto — rebase ABORTADO, el repo quedó limpio. Resuélvelo a mano."
fi
g push --quiet origin main || die "push falló (¿red? ¿ruleset?)"
HEAD_SHA="$(g rev-parse --short HEAD)"
say "${C_GRN}✓ push${C_RST} main @ $HEAD_SHA — el kiosko lo toma en ~1 min (hall-update.timer)"

# 3. synca: el vault padre registra el submodule ------------------------------
if [ "$SYNC" = 1 ]; then
  if command -v synca >/dev/null 2>&1; then
    say "${C_B}— synca —${C_RST}"
    synca || say "${C_YEL}⚠ synca terminó con avisos — mira 'synca status'${C_RST}"
  else
    say "${C_YEL}⚠ synca no está instalado — el vault no registró el puntero nuevo${C_RST}"
  fi
fi

# 4. --wait: confirmar que el Jetson ya lo tiene ------------------------------
if [ "$WAIT" = 1 ]; then
  FULL_SHA="$(g rev-parse HEAD)"
  say "esperando a que $JETSON llegue a $HEAD_SHA (máx 3 min)…"
  for _ in $(seq 1 18); do
    REMOTE="$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$JETSON" \
              'git -C ~/HalLMediaPipe rev-parse HEAD' 2>/dev/null)"
    if [ "$REMOTE" = "$FULL_SHA" ]; then
      say "${C_GRN}✓ el Jetson ya está en $HEAD_SHA${C_RST}"
      if curl -sf -m 4 "$HEALTH" >/dev/null 2>&1; then
        say "${C_GRN}✓ kiosko responde en /healthz${C_RST}"
      else
        say "${C_YEL}· kiosko aún reiniciando (healthz no responde todavía)${C_RST}"
      fi
      exit 0
    fi
    sleep 10
  done
  say "${C_YEL}⚠ 3 min y el Jetson no reporta el commit — ¿encendido? ¿Tailscale? Mira: ssh $JETSON systemctl --user status hall-update.timer${C_RST}"
  exit 1
fi
