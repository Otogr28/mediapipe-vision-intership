[Unit]
Description=HalLMediaPipe kiosk (web backend + fullscreen browser)
# Tied to the graphical session: starts when the desktop comes up (with GDM
# autologin that means straight after boot) and stops with it.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/HalLMediaPipe/deploy/hall-app/hallkiosk
# Appliance semantics: the pair always comes back (browser closed, backend
# self-exited on a camera stall, crash — anything). `systemctl --user stop`
# still stops it for real.
Restart=always
RestartSec=5
Environment=DISPLAY=:0

[Install]
WantedBy=graphical-session.target
