# Python
__pycache__/
*.py[cod]
*.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Env files / secrets
.env
.env.*
!.env.example
*.local.md
SECRETS.local.md

# IDEs/editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Media / generated files
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
*.webp

# But allow sample assets if you create this folder
!assets/
!assets/samples/
!assets/samples/**

# Model/checkpoint files
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.pkl
*.joblib

# Local data/output
data/
outputs/
runs/
captures/
recordings/

# Build artifacts
build/
dist/
*.egg-info/

# ...but the built web frontend IS committed on purpose: the Jetson kiosk
# auto-updates by `git pull` and never runs Node, so web/dist must travel in
# the repo. This negation re-includes it despite the `dist/` rule above
# (web/.gitignore documents the same intent; the rule here was silently
# dropping it, so frontend changes never reached the device via git).
!web/dist/
!web/dist/**

# Schrodinger scene sprites (CC0, see web/src/assets/schrodinger/CREDITS.md):
# committed on purpose past the *.png rule — the cv2 fallback reads them from
# this path and the Jetson only receives what git carries.
!web/src/assets/**

# The exhibit website (GitHub Pages serves docs/ from main): its screenshots
# (docs/img/*.jpg) must survive the global image rules above.
!docs/**

# Internal notes, logs and Claude-harness files are local-only: the public
# repo keeps only code, assets and READMEs. (Last rule wins: this also
# overrides the asset negations above for .md files, e.g. CREDITS.md.)
*.md
!README.md
.claude/
